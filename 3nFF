local function createToggle(text, yPos, color, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.92, 0, 0, 34)
    frame.Position = UDim2.new(0.04, 0, yPos, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 45)
    frame.BorderSizePixel = 1
    frame.BorderColor3 = Color3.fromRGB(50, 50, 90)
    frame.Parent = mainFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.55, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 230)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 65, 0.8, 0)
    btn.Position = UDim2.new(0.7, 0, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
    btn.BorderSizePixel = 2
    btn.BorderColor3 = color or Color3.fromRGB(255, 170, 50)
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(50, 50, 80)
        if callback then callback(state) end
    end)

    return btn, frame
end

-- =========================================== --
-- دالة إنشاء سلايدر (مثل الصورة)
-- =========================================== --
local function createSlider(parent, text, yPos, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.92, 0, 0, 34)
    frame.Position = UDim2.new(0.04, 0, yPos, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 45)
    frame.BorderSizePixel = 1
    frame.BorderColor3 = Color3.fromRGB(50, 50, 90)
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. " " .. tostring(default) .. "%"
    label.TextColor3 = Color3.fromRGB(220, 220, 230)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.Parent = frame

    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.35, 0, 0.5, 0)
    slider.Position = UDim2.new(0.58, 0, 0.25, 0)
    slider.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
    slider.BorderSizePixel = 1
    slider.BorderColor3 = Color3.fromRGB(255, 170, 50)
    slider.Parent = frame

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 170, 50)
    fill.BorderSizePixel = 0
    fill.Parent = slider

    local value = default
    local dragging = false

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    slider.MouseMoved:Connect(function()
        if dragging then
            local mouse = player:GetMouse()
            local relX = (mouse.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X
            local clamped = math.clamp(relX, 0, 1)
            fill.Size = UDim2.new(clamped, 0, 1, 0)
            value = math.floor(min + clamped * (max - min))
            label.Text = text .. " " .. tostring(value) .. "%"
            if callback then callback(value) end
        end
    end)

    return fill, frame
end

