local function createTab(name, icon, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 75, 0, 28)
    btn.Position = UDim2.new(0, 5 + (yPos - 1) * 80, 0, 50)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(0, 150, 255)
    btn.Text = icon
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.Parent = mainFrame
    
    local frame = Instance.new("ScrollingFrame")
    frame.Size = UDim2.new(1, -20, 1, -110)
    frame.Position = UDim2.new(0, 10, 0, 82)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.CanvasSize = UDim2.new(0, 0, 0, 0)
    frame.ScrollBarThickness = 5
    frame.ScrollBarImageColor3 = Color3.fromRGB(0, 150, 255)
    frame.Visible = false
    frame.Parent = mainFrame
    
    tabButtons[name] = btn
    tabs[name] = frame
    return frame
end

