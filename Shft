-- Delta / Mobile Shift Lock Script
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- إنشاء زر القفل المتحرك على الشاشة
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ShiftLockGUI"
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local ShiftButton = Instance.new("ImageButton")
ShiftButton.Name = "ShiftLockButton"
ShiftButton.Size = UDim2.new(0, 50, 0, 50)
ShiftButton.Position = UDim2.new(0.85, 0, 0.4, 0) -- مكان الزر على الشاشة
ShiftButton.BackgroundTransparency = 1
ShiftButton.Image = "rbxassetid://10734920211" -- أيكونة القفل
ShiftButton.Parent = ScreenGui

-- تحريك الزر بالسحب (Draggable)
local dragging, dragInput, dragStart, startPos

ShiftButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ShiftButton.Position
    end
end)

ShiftButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        ShiftButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- تفعيل وتعطيل الـ Shift Lock
local enabled = false

local function toggleShiftLock()
    enabled = not enabled
    if enabled then
        ShiftButton.ImageColor3 = Color3.fromRGB(0, 255, 127) -- يضيء بالأخضر عند التفعيل
    else
        ShiftButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end
end

ShiftButton.MouseButton1Click:Connect(toggleShiftLock)

RunService.RenderStepped:Connect(function()
    if enabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.AutoRotate = false
        local cameraCFrame = Camera.CFrame
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position, LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(cameraCFrame.LookVector.X, 0, cameraCFrame.LookVector.Z))
    elseif LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.AutoRotate = true
    end
end)
