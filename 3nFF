local function createDropdown(parent, text, yPos, items, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.92, 0, 0, 34)
    frame.Position = UDim2.new(0.04, 0, yPos, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 45)
    frame.BorderSizePixel = 1
    frame.BorderColor3 = Color3.fromRGB(50, 50, 90)
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0.03, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 230)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.Parent = frame

    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.new(0.35, 0, 0.8, 0)
    dropdown.Position = UDim2.new(0.58, 0, 0.1, 0)
    dropdown.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
    dropdown.BorderSizePixel = 1
    dropdown.BorderColor3 = Color3.fromRGB(255, 170, 50)
    dropdown.Text = items[1]
    dropdown.TextColor3 = Color3.fromRGB(255, 255, 255)
    dropdown.TextScaled = true
    dropdown.Font = Enum.Font.Gotham
    dropdown.Parent = frame

    local selected = 1
    dropdown.MouseButton1Click:Connect(function()
        selected = selected % #items + 1
        dropdown.Text = items[selected]
        if callback then callback(items[selected]) end
    end)

    return dropdown, frame
end

